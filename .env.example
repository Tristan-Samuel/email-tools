# Copy to .env and set your values. The app loads this file on startup.
GROQ_API_KEY=
# Optional: default fallback model if model discovery fails.
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
# Optional: dedicated Fernet key for IMAP/Groq secrets. If unset, derived from FLASK_SECRET_KEY.
# CREDENTIAL_ENCRYPTION_KEY=

# Outbound SMTP for signup verification codes (required in production).
# Example (Gmail): host smtp.gmail.com, port 587, username = mailbox, password = App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
