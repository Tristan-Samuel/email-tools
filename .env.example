# Copy to .env and set your values. The app loads this file on startup.

# Required in production (ENV=production or FLASK_ENV=production).
FLASK_SECRET_KEY=
# Optional: dedicated Fernet key for IMAP/AI secrets. If unset, derived from FLASK_SECRET_KEY.
# Rotating FLASK_SECRET_KEY without this (or without re-saving IMAP/AI credentials) breaks decrypt.
# CREDENTIAL_ENCRYPTION_KEY=

# Optional override for the SQLite path (Docker volume typically uses /app/instance/email_tools.db).
# EMAIL_TOOLS_DATABASE=

# Personal-server signup gate. Production requires SIGNUP_ALLOWED_EMAIL and/or SIGNUP_INVITE_TOKEN.
# SIGNUP_ALLOWED_EMAIL=you@gmail.com
# SIGNUP_INVITE_TOKEN=

GEMINI_API_KEY=
# Or use GOOGLE_API_KEY as an alias for GEMINI_API_KEY.
# GOOGLE_API_KEY=
# Optional: default Gemini model (token-budget batches use Flash-Lite by default).
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
# Optional: rate limits — match your Google AI Studio dashboard.
# GEMINI_RPM=15
# GEMINI_TPM=250000
# GEMINI_TPD=1500000
GROQ_API_KEY=
# Optional: Groq fallback model if model discovery fails.
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
# Optional: dedicated Fernet key for IMAP/Groq/Gemini secrets. If unset, derived from FLASK_SECRET_KEY.
# CREDENTIAL_ENCRYPTION_KEY=

# Outbound SMTP for signup verification codes (required in production).
# Example (Gmail): host smtp.gmail.com, port 587, username = mailbox, password = App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
